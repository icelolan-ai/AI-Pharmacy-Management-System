APP_ENV=development
DATABASE_URL=
SUPABASE_URL=
CORS_ORIGINS=http://localhost:3000
STORE_TIMEZONE=Asia/Bangkok

# D53 — AI provider. Leave the key empty here; fill it in backend/.env only.
# backend/.env is not committed; this file is.
AI_PROVIDER=gemini
GEMINI_API_KEY=
# Leave empty until a model is chosen from `python -m app.ai.check list`.
AI_MODEL=

# 6.2 — invoice photos. The service role key bypasses every database rule;
# it lives in backend/.env only and never in anything the web can read.
SUPABASE_SERVICE_ROLE_KEY=
# Limits (D72: measured or guessed is noted in app/config.py). Defaults shown.
MAX_UPLOAD_BYTES=31457280
STORED_MAX_BYTES=10485760
ORIGINAL_MAX_EDGE_PX=3000
ORIGINAL_JPEG_QUALITY=88
AI_IMAGE_MAX_EDGE_PX=1600
AI_IMAGE_JPEG_QUALITY=80
SIGNED_URL_TTL_SECONDS=600
